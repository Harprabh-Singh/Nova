{
  "compilerOptions": {
    "target": "ES2023",
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": false,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "types": [
      "node"
    ],
    "typeRoots": [
      "/vercel/sandbox/node_modules/@types",
      "./node_modules/@types"
    ],
    "allowImportingTsExtensions": true
  },
  "include": [
    "backend/src/**/*.ts",
    "backend/scripts/**/*.ts",
    "scripts/**/*.ts",
    "tests/**/*.ts"
  ]
}

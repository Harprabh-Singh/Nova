# ---------------------------------------------------------------------------
# NOVA configuration
# ---------------------------------------------------------------------------
# Local/demo defaults use SQLite. Production/Azure mode requires a real
# PostgreSQL connection supplied through the deployment environment only.
AI_MODE=local
KNOWLEDGE_MODE=local
AUTH_MODE=demo
ACTION_MODE=local
VECTOR_STORE=local
# Where document FILES live. local = filesystem (STORAGE_DIR),
# azure_blob = Azure Blob Storage. There is no fallback: azure_blob without
# complete configuration fails at startup instead of writing to local disk.
STORAGE_MODE=local

PORT=4317
HOST=127.0.0.1
LOG_LEVEL=info

# HTTPS. Off by default: the local server runs on http://localhost:4317, and
# browsers already treat localhost as a secure context. Deployments normally
# terminate TLS in front of NOVA (App Service, load balancer, reverse proxy),
# which also needs no change here.
#
# Set HTTPS_ENABLED=true only when NOVA itself must terminate TLS, and point
# TLS_CERT_FILE/TLS_KEY_FILE at a real certificate. NOVA never invents one and
# never downgrades silently: if the certificate cannot be read, it won't start.
HTTPS_ENABLED=false
# TLS_CERT_FILE=/path/to/fullchain.pem
# TLS_KEY_FILE=/path/to/privkey.pem

# Local/demo persistence
DATABASE_URL=file:./data/nova.db
# Production/Azure only (replace the placeholder outside source control):
# DATABASE_URL=<your-neon-postgresql-connection-string>
# Local/demo document files (STORAGE_MODE=local only)
STORAGE_DIR=./data/storage
# Hard upload ceiling, enforced before anything is written to storage.
MAX_DOCUMENT_SIZE_BYTES=15728640
SEED_KNOWLEDGE_DIR=./knowledge

DEMO_SESSION_SECRET=local-dev-only-change-me
LOCAL_LLM_BASE_URL=
LOCAL_LLM_MODEL=qwen2.5:7b-instruct
LOCAL_LLM_API_KEY=
LOCAL_LLM_TIMEOUT_MS=60000
LOCAL_EMBEDDING_BASE_URL=
LOCAL_EMBEDDING_MODEL=nova-hashed-lexical-v1
EMBEDDING_DIM=384
RETRIEVAL_TOP_K=8
RETRIEVAL_CANDIDATES=40
HYBRID_VECTOR_WEIGHT=0.6
HYBRID_KEYWORD_WEIGHT=0.4
CHUNK_TARGET_CHARS=1100
CHUNK_OVERLAP_CHARS=150

FOUNDRY_PROJECT=nova-foundry
FOUNDRY_ENDPOINT=https://nova-foundry-hn-2376.services.ai.azure.com/api/projects/nova-foundry
FOUNDRY_MODEL_DEPLOYMENT=nova-chat
AZURE_EMBEDDING_DEPLOYMENT=nova-embedding
# Optional: separate endpoint for the embedding deployment when it is served at
# the Azure AI Services resource level rather than the Foundry project level.
# Defaults to FOUNDRY_ENDPOINT when not set.
# AZURE_EMBEDDING_ENDPOINT=https://<resource>.services.ai.azure.com
FOUNDRY_AGENT_ID=
# Azure AI Search (production/Azure retrieval layer; VECTOR_STORE=azure_search).
# The endpoint and index name are not secrets. AZURE_SEARCH_ADMIN_KEY is a
# secret and must come from the deployment environment: never put a real key
# in this file, in documentation, or in source control.
AZURE_SEARCH_ENDPOINT=
AZURE_SEARCH_INDEX=nova-knowledge
AZURE_SEARCH_API_VERSION=2024-07-01
# AZURE_SEARCH_ADMIN_KEY=<supplied-through-the-environment>
# Azure Blob Storage (production/Azure document files; STORAGE_MODE=azure_blob).
# The account and container names are not secrets. The connection string IS a
# secret and must come from the deployment environment: never put a real
# connection string in this file, in documentation, or in source control.
# The `documents` container must stay PRIVATE (no anonymous access).
AZURE_STORAGE_ACCOUNT=novastorage2376
AZURE_STORAGE_CONTAINER=documents
AZURE_STORAGE_CONNECTION_STRING=<your-storage-connection-string>
# ---------------------------------------------------------------------------
# Microsoft Entra ID (Phase 6) - AUTH_MODE=entra only.
#
# Every value below is PUBLIC application configuration, not a secret: the
# browser needs them to run the Authorization Code + PKCE flow. The NOVA
# Entra app is a single-tenant SPA / PUBLIC client, so there is deliberately
# NO client secret - do not add one (AUTH_MODE=entra refuses to start if
# ENTRA_CLIENT_SECRET or AZURE_CLIENT_SECRET is set).
#
# Entra answers "who is this human?". Neon still answers "which NOVA user,
# tenant, role, department and clearance?" - see docs/security.md.
ENTRA_TENANT_ID=191223fe-a651-4b8c-a79d-8b368bba577d
ENTRA_CLIENT_ID=9bb0d161-2be5-4d0c-b5f5-8c54211c0d1d
ENTRA_API_ID_URI=api://9bb0d161-2be5-4d0c-b5f5-8c54211c0d1d
ENTRA_API_SCOPE=api://9bb0d161-2be5-4d0c-b5f5-8c54211c0d1d/access_as_user
ENTRA_AUTHORITY=https://login.microsoftonline.com/191223fe-a651-4b8c-a79d-8b368bba577d
# Must match a redirect URI registered on the Entra application EXACTLY.
# In Entra mode NOVA binds this port and fails clearly if it is busy.
ENTRA_REDIRECT_URI=http://localhost:4317
# First-time Entra users. Default (false): an unknown identity is denied with
# 403 until an administrator links it to a NOVA user. When true, a PENDING,
# privilege-free user is created in ENTRA_AUTO_PROVISION_TENANT_ID and an
# administrator must approve it. A role/department/clearance is never inferred
# from an email address, domain or display name.
ENTRA_AUTO_PROVISION=false
# ENTRA_AUTO_PROVISION_TENANT_ID=
# ENTRA_AUTO_PROVISION_ROLE_KEY=PENDING
# ENTRA_AUTO_PROVISION_DEPARTMENT=Unassigned

# Browser build fallback for the same public values (esbuild `define`). The SPA
# normally reads them at runtime from GET /api/auth/config, so these are
# optional.
# VITE_ENTRA_CLIENT_ID=9bb0d161-2be5-4d0c-b5f5-8c54211c0d1d
# VITE_ENTRA_TENANT_ID=191223fe-a651-4b8c-a79d-8b368bba577d
# VITE_ENTRA_AUTHORITY=https://login.microsoftonline.com/191223fe-a651-4b8c-a79d-8b368bba577d
# VITE_ENTRA_API_SCOPE=api://9bb0d161-2be5-4d0c-b5f5-8c54211c0d1d/access_as_user
# VITE_ENTRA_REDIRECT_URI=http://localhost:4317

# Legacy aliases, still accepted for the values above.
# AZURE_TENANT_ID=
# AZURE_CLIENT_ID=
AZURE_API_KEY=
AZURE_ACCESS_TOKEN=
APPLICATIONINSIGHTS_CONNECTION_STRING=

# ---------------------------------------------------------------------------
# Governed enterprise actions (Phase 8)
# ---------------------------------------------------------------------------
# ACTION_MODE=local  (default) NOVA's own mock executor runs the three
#                    registered actions. Nothing leaves the process and every
#                    result is labelled SIMULATED ACTION in the UI and in the
#                    action_requests audit table.
# ACTION_MODE=azure  The NOVA Actions Azure Function app executes them. There
#                    is NO fallback: without AZURE_ACTION_FUNCTION_URL the
#                    process refuses to start, because quietly simulating a
#                    write that a person was told had happened is worse than
#                    failing. See docs/governed-actions.md.
#
# The base URL is the Function app ORIGIN; NOVA appends /api/actions/<route>.
# AZURE_ACTION_FUNCTION_URL=https://nova-actions.azurewebsites.net
# SECRET - supply through the deployment environment or Key Vault only. Never
# commit a real value, and never put it in a URL.
# AZURE_ACTION_FUNCTION_KEY=
# AZURE_ACTION_FUNCTION_TIMEOUT_MS=20000

# Legacy Phase 4 incident workflow endpoint (Logic App / generic HTTPS route).
# Still honoured by the incident ActionProvider; the Phase 8 registry uses the
# Function app above.
# AZURE_ACTION_WORKFLOW_URL=
# AZURE_ACTION_API_KEY=

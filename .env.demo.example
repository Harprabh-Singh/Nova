# ===========================================================================
# NOVA - LIVE DEMONSTRATION CONFIGURATION
# ===========================================================================
#
# Purpose: the ENTIRE knowledge stack stays Azure-backed, and ONLY the
# governed-action executor runs locally.
#
#   Authentication   -> Microsoft Entra ID
#   Database         -> Neon PostgreSQL
#   AI (chat + embed)-> Microsoft Foundry
#   Retrieval        -> Azure AI Search
#   Document files   -> Azure Blob Storage
#   Governed actions -> LocalMockExecutor   <-- the only local component
#
# The NOVA Actions Azure Function app is NOT used and NOT required. Do not set
# AZURE_ACTION_FUNCTION_URL / AZURE_ACTION_FUNCTION_KEY for this demo: they are
# read only when ACTION_MODE=azure. The Function app remains the future
# production execution target.
#
# NOTHING in this file is a real credential. Replace every <PLACEHOLDER>.
# Copy to `.env` (which is gitignored) before running:
#   cp .env.demo.example .env
#
# ---------------------------------------------------------------------------
# HONESTY NOTE
# ---------------------------------------------------------------------------
# With ACTION_MODE=local, GET /api/actions reports "simulated": true and the UI
# badge reads SIMULATED ACTION. Every action result is suffixed
# "(SIMULATED - no external system of record was written.)". Present this as
# "governed action executed in local/demo mode", never as an Azure Function
# execution.
# ===========================================================================


# ---------------------------------------------------------------------------
# 1. PROVIDER MODES  (public configuration - the whole point of this file)
# ---------------------------------------------------------------------------
# Each provider is selected independently. ACTION_MODE=local affects ONLY the
# action executor; it does not touch AI, retrieval, storage, auth or the
# database. Verified by tests/providerModes.test.ts.
AI_MODE=azure
KNOWLEDGE_MODE=azure
AUTH_MODE=entra
VECTOR_STORE=azure_search
STORAGE_MODE=azure_blob

# The only local component. Runs LocalMockExecutor through the FULL Phase 8
# governance pipeline (authorization -> confirmation -> re-authorization ->
# audit); only the final write is simulated.
ACTION_MODE=local

# Do NOT set APP_MODE. It is derived from the modes above and startup fails if
# a declared value disagrees with the derived one.
# APP_MODE=


# ---------------------------------------------------------------------------
# 2. SERVER  (public configuration)
# ---------------------------------------------------------------------------
# In AUTH_MODE=entra the port is taken from ENTRA_REDIRECT_URI and the port
# fallback is disabled, so NOVA always serves the exact registered redirect
# origin. Leave PORT unset, or set it to the SAME port as the redirect URI.
# PORT=4317
HOST=127.0.0.1
LOG_LEVEL=info


# ---------------------------------------------------------------------------
# 3. DATABASE - Neon PostgreSQL  (SECRET: contains a password)
# ---------------------------------------------------------------------------
# Required: with any Azure provider selected, a non-PostgreSQL DATABASE_URL is
# refused at startup - there is no silent SQLite fallback.
# Use the POOLED Neon URL for the application.
DATABASE_URL=<NEON_CONNECTION_STRING>

# Apply migrations 001-006 before the demo (see section 9).


# ---------------------------------------------------------------------------
# 4. MICROSOFT FOUNDRY - chat + embeddings
# ---------------------------------------------------------------------------
# PUBLIC configuration. The project name is lowercase.
FOUNDRY_ENDPOINT=<FOUNDRY_PROJECT_ENDPOINT>
FOUNDRY_PROJECT=nova-foundry
FOUNDRY_MODEL_DEPLOYMENT=nova-chat
AZURE_EMBEDDING_DEPLOYMENT=nova-embedding

# Vector width NOVA asks the embedding deployment for. It MUST equal the vector
# dimension of the live Azure AI Search index (`npm run search:validate`
# prints both). Changing it requires rebuilding the index.
EMBEDDING_DIM=384

# SECRET - exactly one of these. AZURE_ACCESS_TOKEN wins when both are present.
AZURE_API_KEY=<FOUNDRY_KEY>
# AZURE_ACCESS_TOKEN=<FOUNDRY_ACCESS_TOKEN>


# ---------------------------------------------------------------------------
# 5. AZURE AI SEARCH - retrieval
# ---------------------------------------------------------------------------
# PUBLIC configuration.
AZURE_SEARCH_ENDPOINT=<SEARCH_ENDPOINT>
AZURE_SEARCH_INDEX=nova-knowledge
AZURE_SEARCH_API_VERSION=2024-07-01

# SECRET.
AZURE_SEARCH_ADMIN_KEY=<SEARCH_KEY>


# ---------------------------------------------------------------------------
# 6. AZURE BLOB STORAGE - document files
# ---------------------------------------------------------------------------
# PUBLIC configuration. AZURE_STORAGE_ACCOUNT is optional; when set it is
# verified against the connection string and a mismatch is refused.
AZURE_STORAGE_ACCOUNT=<STORAGE_ACCOUNT_NAME>
AZURE_STORAGE_CONTAINER=documents

# SECRET - contains the account key.
AZURE_STORAGE_CONNECTION_STRING=<STORAGE_CONNECTION_STRING>


# ---------------------------------------------------------------------------
# 7. MICROSOFT ENTRA ID - authentication
# ---------------------------------------------------------------------------
# ALL PUBLIC. NOVA's Entra app is a single-tenant SPA / PUBLIC client using
# Authorization Code + PKCE, so there is deliberately NO client secret. Setting
# ENTRA_CLIENT_SECRET or AZURE_CLIENT_SECRET makes startup FAIL - leave both out.
#
# ENTRA_AUTHORITY must be exactly https://login.microsoftonline.com/<tenant>.
# /common, /organizations and /consumers are refused.
ENTRA_TENANT_ID=<ENTRA_DIRECTORY_TENANT_ID>
ENTRA_CLIENT_ID=<ENTRA_APPLICATION_CLIENT_ID>
ENTRA_API_ID_URI=api://<ENTRA_APPLICATION_CLIENT_ID>
ENTRA_API_SCOPE=api://<ENTRA_APPLICATION_CLIENT_ID>/access_as_user
ENTRA_AUTHORITY=https://login.microsoftonline.com/<ENTRA_DIRECTORY_TENANT_ID>

# Must match a redirect URI registered on the Entra application EXACTLY.
ENTRA_REDIRECT_URI=<ENTRA_REGISTERED_REDIRECT_URI>

# First-time Entra users. Keep false for the demo: an unlinked identity is
# denied with 403 until an administrator links it to a NOVA user, and a role,
# department or clearance is never inferred from an email or display name.
# Link demo users in advance via POST /api/admin/users/:id/entra-link.
ENTRA_AUTO_PROVISION=false


# ---------------------------------------------------------------------------
# 8. GOVERNED ACTIONS - intentionally LOCAL
# ---------------------------------------------------------------------------
# Deliberately NOT set. These are read only when ACTION_MODE=azure, and
# ACTION_MODE=azure without AZURE_ACTION_FUNCTION_URL refuses to start rather
# than silently simulating a write.
# AZURE_ACTION_FUNCTION_URL=
# AZURE_ACTION_FUNCTION_KEY=

# Legacy Phase 4 incident workflow. Also unused in local action mode.
# AZURE_ACTION_WORKFLOW_URL=
# AZURE_ACTION_API_KEY=


# ---------------------------------------------------------------------------
# 9. PRE-DEMO CHECKLIST (commands, not settings)
# ---------------------------------------------------------------------------
#   npm install
#   npm run db:migrate           # applies 001-006 to Neon
#   npm run db:status            # expect: database is up to date
#   npm run storage:validate     # confirms the Blob container is reachable
#   npm run search:validate      # confirms the index schema + vector width
#   npm run search:reindex -- --force
#       ^ IMPORTANT. `search:index` reuses whatever vectors are already stored
#         in document_chunks. If the index was populated while AI_MODE=local,
#         it holds hashed-lexical vectors, and Foundry query vectors are not
#         comparable to them - vector retrieval degrades to the keyword half.
#         Run this ONCE with AI_MODE=azure so document and query vectors come
#         from the same Foundry deployment. It DOES consume embedding tokens.
#   npm run build:web
#   npm start
#
# Then grant action permissions to the demo roles (see docs/governed-actions.md):
#   actions.it.create_request
#   actions.approval.submit_request
#   actions.hr.create_onboarding_checklist
